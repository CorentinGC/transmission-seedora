# Seedora web app: server environment. Copy to `.env.local` for local overrides, or set these in
# the host's environment. Nothing is required for local development. Never commit real values.
# Reference: docs/setup.md#environment-variables, docs/security.md.

# Secret that seals the session cookie. REQUIRED in production (at least 32 characters): the
# server refuses to start without it. Generate with: openssl rand -base64 32
# In development an unset value gives a random per-process secret (sessions reset on restart).
COOKIE_SECRET=

# Secret being rotated out, accepted for reading only. Set it to the old COOKIE_SECRET while
# deploying a new one, remove it after 4 hours (the cookie lifetime).
# COOKIE_SECRET_PREVIOUS=

# Exact value `true` lets the server reach loopback, private and link-local addresses (daemon on
# the same LAN). Leave unset on a public deployment. Cloud-metadata addresses stay denied.
# SEEDORA_ALLOW_PRIVATE_HOSTS=true

# With the opt-in above: only these hosts may resolve to private addresses. Comma-separated
# `host` or `host:port` (IPv6 as [addr] or [addr]:port). Prefer host:port.
# SEEDORA_ALLOWED_HOSTS=nas.lan:9091

# Exact value `true`: read the client IP for rate limiting from the last X-Forwarded-For entry.
# Set only behind a reverse proxy that overwrites that header. Not needed on Vercel. Without a
# trusted client identity there is no per-client rate limit.
# SEEDORA_TRUST_PROXY_HEADERS=true
