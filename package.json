{
  "name": "seedora",
  "productName": "Seedora",
  "version": "1.2.1",
  "description": "Cross-platform remote GUI for Transmission BitTorrent daemon",
  "main": ".vite/build/index.js",
  "homepage": "https://www.seedora.app",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "start": "electron-forge start",
    "start:debug": "electron-forge start -- --remote-debugging-port=9222",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "npm run dev --workspace=@seedora/web",
    "dev:web:https": "npm run dev:https --workspace=@seedora/web",
    "build:web": "npm run build --workspace=@seedora/web",
    "start:web": "npm run start --workspace=@seedora/web",
    "generate:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "transmission",
    "bittorrent",
    "torrent",
    "remote",
    "gui",
    "electron",
    "pwa",
    "seedbox"
  ],
  "author": {
    "name": "CorentinGC",
    "email": "contact@eden-solutions.pro"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.2.1",
    "@types/chokidar": "^1.7.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/geoip-lite": "^1.4.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "40.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "geoip-lite": "^1.4.10",
    "https-proxy-agent": "^7.0.6",
    "i18next": "^25.8.14",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "socks-proxy-agent": "^8.0.5",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorentinGC/transmission-seedora.git"
  },
  "bugs": {
    "url": "https://github.com/CorentinGC/transmission-seedora/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.12.1"
}
