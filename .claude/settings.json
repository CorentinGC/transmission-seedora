{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run i18n:check:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:web:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(node scripts/i18n-check.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(bd ready:*)",
      "Bash(bd list:*)",
      "Bash(bd show:*)",
      "Bash(bd create:*)",
      "Bash(bd update:*)",
      "Bash(bd close:*)",
      "Bash(bd dep:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools-web__list_pages",
      "mcp__chrome-devtools-web__select_page",
      "mcp__chrome-devtools-web__take_screenshot",
      "mcp__chrome-devtools-web__take_snapshot",
      "mcp__chrome-devtools-web__list_console_messages"
    ],
    "deny": [
      "Bash(npm start:*)",
      "Bash(npm run start:*)",
      "Bash(npm run dev:web:*)",
      "Bash(npm run start:web:*)",
      "Bash(npm run publish:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude/post-edit-check.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
